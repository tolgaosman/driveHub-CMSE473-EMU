digraph L1 {
graph [fontname="Arial" fontsize=12 bgcolor="white" pad=0.2 nodesep=0.35 ranksep=0.45 rankdir=TB splines=spline nodesep=0.45 ranksep=0.7];
node [fontname="Arial" fontsize=11 style="filled" fillcolor="#EEF3FA" color="#3B5B85" penwidth=1.2];
edge [fontname="Arial" fontsize=9.5 color="#4A4A4A" arrowsize=0.7];

node [shape=circle width=1.25 fixedsize=true];
a1 [label="6.1\nSchedule\nAuction"]; a2 [label="6.2\nOpen Room &\nJoin Bidders"]; a3 [label="6.3\nValidate &\nAccept Bid"];
a4 [label="6.4\nBroadcast\nUpdates"]; a5 [label="6.5\nClose Auction\n& Settle"];
node [shape=box fixedsize=false width=0 fillcolor="#FFF8E1" color="#8D6E00"];
mgr [label="Gallery Manager"]; dlr [label="Dealer / Bidder"];
node [shape=record fillcolor="#E8F5E9" color="#2E7D32"];
d5 [label="D5 | Valuations"]; d6 [label="D6 | Auctions & Bids"]; d7 [label="D7 | Live Auction State"]; d2 [label="D2 | Vehicles"];
mgr -> a1 [label="start, reserve,\nincrement, times"]; d5 -> a1 [label="suggested price"];
a1 -> d6 [label="auction (SCHEDULED)"];
d6 -> a2 [label="auction"]; dlr -> a2 [label="join (JWT)"]; a2 -> d7 [label="room state"];
dlr -> a3 [label="bid amount"]; d7 -> a3 [label="highest bid,\nend time"]; a3 -> d7 [label="new highest"];
a3 -> d6 [label="bid log (async)"]; a3 -> a4 [label="accepted bid"]; a3 -> dlr [label="rejection" constraint=false];
a4 -> dlr [label="NEW_HIGHEST_BID"];
d7 -> a5 [label="final state"]; a5 -> d6 [label="SOLD / NOT_SOLD"]; a5 -> d2 [label="vehicle status"];
a5 -> mgr [label="result"];
}