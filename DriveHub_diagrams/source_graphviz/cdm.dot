digraph CDM {
graph [fontname="Arial" fontsize=12 bgcolor="white" pad=0.2 nodesep=0.35 ranksep=0.45 rankdir=LR splines=spline nodesep=0.25 ranksep=0.35];
node [fontname="Arial" fontsize=11 style="filled" fillcolor="#EEF3FA" color="#3B5B85" penwidth=1.2];
edge [fontname="Arial" fontsize=9.5 color="#4A4A4A" arrowsize=0.7];
node [shape=box fillcolor="#EEF3FA" fontsize=11];
TENANT;
USER;
VEHICLE;
INSPECTION;
MEDIA_ASSET;
DAMAGE;
VALUATION;
AUCTION;
BID;
SALE;
node [shape=diamond fillcolor="#FFF8E1" color="#8D6E00" fontsize=9 margin=0.02];
edge [arrowhead=none];
r0 [label="employs"];
TENANT -> r0 [taillabel="1" labeldistance=1.6 fontsize=9];
r0 -> USER [headlabel="N" labeldistance=1.6 fontsize=9];
r1 [label="owns"];
TENANT -> r1 [taillabel="1" labeldistance=1.6 fontsize=9];
r1 -> VEHICLE [headlabel="N" labeldistance=1.6 fontsize=9];
r2 [label="undergoes"];
VEHICLE -> r2 [taillabel="1" labeldistance=1.6 fontsize=9];
r2 -> INSPECTION [headlabel="N" labeldistance=1.6 fontsize=9];
r3 [label="performs"];
USER -> r3 [taillabel="1" labeldistance=1.6 fontsize=9];
r3 -> INSPECTION [headlabel="N" labeldistance=1.6 fontsize=9];
r4 [label="contains"];
INSPECTION -> r4 [taillabel="1" labeldistance=1.6 fontsize=9];
r4 -> MEDIA_ASSET [headlabel="N" labeldistance=1.6 fontsize=9];
r5 [label="shows"];
MEDIA_ASSET -> r5 [taillabel="1" labeldistance=1.6 fontsize=9];
r5 -> DAMAGE [headlabel="N" labeldistance=1.6 fontsize=9];
r6 [label="valued by"];
VEHICLE -> r6 [taillabel="1" labeldistance=1.6 fontsize=9];
r6 -> VALUATION [headlabel="N" labeldistance=1.6 fontsize=9];
r7 [label="informs"];
INSPECTION -> r7 [taillabel="1" labeldistance=1.6 fontsize=9];
r7 -> VALUATION [headlabel="0..1" labeldistance=1.6 fontsize=9];
r8 [label="listed in"];
VEHICLE -> r8 [taillabel="1" labeldistance=1.6 fontsize=9];
r8 -> AUCTION [headlabel="N" labeldistance=1.6 fontsize=9];
r9 [label="receives"];
AUCTION -> r9 [taillabel="1" labeldistance=1.6 fontsize=9];
r9 -> BID [headlabel="N" labeldistance=1.6 fontsize=9];
r10 [label="places"];
USER -> r10 [taillabel="1" labeldistance=1.6 fontsize=9];
r10 -> BID [headlabel="N" labeldistance=1.6 fontsize=9];
r11 [label="results in"];
AUCTION -> r11 [taillabel="1" labeldistance=1.6 fontsize=9];
r11 -> SALE [headlabel="0..1" labeldistance=1.6 fontsize=9];
}